---
type Props = {
  eyebrow?: string
  title: string
  text?: string
  id?: string
  align?: "left" | "center"
  tone?: "dark" | "light"
}

const {
  eyebrow,
  title,
  text,
  id,
  align = "left",
  tone = "dark",
} = Astro.props
---

<div
  class:list={[
    "section-heading",
    `section-heading--${align}`,
    { "section-heading--light": tone === "light" },
  ]}
>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{title}</h2>
  {text && <p class="lede">{text}</p>}
</div>
