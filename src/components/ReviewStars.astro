---
type Props = {
  rating: number
  label?: boolean
}

const { rating, label = true } = Astro.props
const stars = Array.from({ length: 5 }, (_, index) => index < rating)
---

<span
  class="review-stars"
  role={label ? "img" : undefined}
  aria-label={label ? `Rated ${rating} out of 5` : undefined}
>
  <span class="review-stars__icons" aria-hidden="true">
    {
      stars.map((filled) => (
        <svg
          class:list={["review-stars__star", { "is-empty": !filled }]}
          viewBox="0 0 20 20"
          focusable="false"
        >
          <path
            d="M10 1.7l2.47 5.01 5.53.8-4 3.9.94 5.51L10 14.32l-4.94 2.6.94-5.51-4-3.9 5.53-.8L10 1.7z"
            fill="currentColor"
          />
        </svg>
      ))
    }
  </span>
</span>
