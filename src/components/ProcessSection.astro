---
import SectionHeading from "./SectionHeading.astro"

type Step = {
  title: string
  text: string
}

type Props = {
  mainTitle: string
  mainSubtitle: string
  steps: readonly Step[]
}

const { mainTitle, mainSubtitle, steps } = Astro.props
---

<section class="section section--tight process" id="process">
  <div class="container">
    <SectionHeading
      eyebrow="The experience"
      title={mainTitle}
      text={mainSubtitle}
    />

    <div class="process-grid">
      {
        steps.map((step, index) => (
          <article class="process-step" data-reveal>
            <span class="process-step__number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
