---
import ReviewCard from "./ReviewCard.astro"
import { featuredReviews } from "../data/reviews"
---

<section class="ed-reviews" id="reviews">
  <div class="container">
    <div class="ed-reviews__head">
      <div data-reveal>
        <p class="eyebrow">Kind words</p>
        <h2>
          Reviews from Couples Who Chose KD Flowers for Their Niagara Wedding
        </h2>
      </div>
      <a class="text-link ed-reviews__link" href="/reviews/" data-reveal>
        Read all reviews
      </a>
    </div>

    <div class="ed-reviews__grid">
      {featuredReviews.map((review) => <ReviewCard review={review} featured />)}
    </div>

    <p class="ed-reviews__note">
      Kind words from couples who trusted KD Flowers with their wedding flowers.
    </p>
  </div>
</section>
