---
import { site } from "../data/site"

type Service = {
  title: string
  text: string
}

type Props = {
  eyebrow: string
  title: string
  intro: string
  items: readonly Service[]
}

const { eyebrow, title, intro, items } = Astro.props
---

<section class="section ed-services" id="services">
  <div class="container">
    <div class="ed-services__head">
      <div data-reveal>
        <p class="eyebrow">{eyebrow}</p>
        <h2>{title}</h2>
      </div>
      <p class="lede ed-services__intro" data-reveal>{intro}</p>
    </div>

    <div class="ed-services__grid" data-reveal>
      {
        items.map((service, index) => (
          <article class="ed-service">
            <span class="ed-service__number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))
      }
    </div>

    <p class="ed-services__note">
      <a
        class="text-link"
        href={site.booking}
        target="_blank"
        rel="noopener noreferrer"
      >
        Talk through your flowers
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    </p>
  </div>
</section>
