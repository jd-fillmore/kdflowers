---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
import heroImage from "../assets/images/hero.jpg"

type Props = {
  title: string
  eyebrow: string
  intro?: string
  image?: ImageMetadata
  imageAlt?: string
  notes?: string[]
  primaryLabel?: string
  primaryHref?: string
  secondaryLabel?: string
  secondaryHref?: string
}

const {
  title,
  eyebrow,
  intro,
  image = heroImage,
  imageAlt = "KD Flowers wedding flowers in Niagara",
  notes = [],
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props

const externalPrimary = primaryHref?.startsWith("http")
---

<section class="ed-hero ed-hero--page">
  <div class="ed-hero__media">
    <Image
      src={image}
      alt={imageAlt}
      width={1920}
      height={1080}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
      data-reveal="image"
    />
  </div>

  <div class="container ed-hero__inner">
    <div class="ed-hero__content">
      <p class="ed-hero__eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      {intro && <p class="ed-hero__copy">{intro}</p>}

      {
        (primaryLabel && primaryHref) || (secondaryLabel && secondaryHref) ? (
          <div class="ed-hero__actions">
            {primaryLabel && primaryHref ? (
              <a
                class="button button--cream"
                href={primaryHref}
                target={externalPrimary ? "_blank" : undefined}
                rel={externalPrimary ? "noopener noreferrer" : undefined}
              >
                {primaryLabel}
                {externalPrimary ? (
                  <span class="sr-only"> (opens in a new tab)</span>
                ) : null}
              </a>
            ) : null}
            {secondaryLabel && secondaryHref ? (
              <a class="text-link" href={secondaryHref}>
                {secondaryLabel}
              </a>
            ) : null}
          </div>
        ) : null
      }

      {
        notes.length > 0 ? (
          <p class="ed-hero__note">
            {notes.map((note) => (
              <span>{note}</span>
            ))}
          </p>
        ) : null
      }
    </div>
  </div>
</section>
