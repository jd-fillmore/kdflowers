---
import BaseLayout from "../layouts/BaseLayout.astro"
import PageHero from "../components/PageHero.astro"
import bookingHeroImage from "../assets/images/10.jpg"
import { home, site } from "../data/site"

const breadcrumbs = [{ label: "Home", href: "/" }, { label: "Book A Consult" }]
---

<BaseLayout
  title="Book A Consult"
  path="/book-consult/"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    title="Book A Consult"
    eyebrow="Free consultation"
    intro="Choose a time to talk through your wedding flowers, colours and vision with Kylee. The consultation is complimentary and there is no obligation."
    image={bookingHeroImage}
    imageAlt="Romantic blush, burgundy and greenery bridal bouquet"
    notes={["Complimentary", "No obligation", "Niagara & St. Catharines"]}
    secondaryLabel="View the portfolio"
    secondaryHref="/portfolio/"
  />

  <section class="pg-booking">
    <div class="container pg-booking__grid">
      <div data-reveal>
        <p class="eyebrow">What happens next</p>
        <h2>A thoughtful plan, from first call to final flowers.</h2>
        <ol class="pg-booking__steps">
          {
            home.process.steps.map((step, index) => (
              <li class="pg-booking__step">
                <span class="pg-booking__number" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <aside class="pg-booking__card" data-reveal>
        <p class="eyebrow eyebrow--light">Reserve your consultation</p>
        <h2>Let’s talk about your flowers.</h2>
        <p>
          Booking takes just a moment through Calendly. Choose a time that works
          for you, and Kylee will follow up from there.
        </p>
        <a
          class="button button--cream"
          href={site.booking}
          target="_blank"
          rel="noopener noreferrer"
        >
          Book a free consultation
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
        <p class="pg-booking__card-note">Free consultation · No obligation</p>
        <a
          class="text-link"
          href={site.instagram}
          target="_blank"
          rel="noopener noreferrer"
        >
          Follow on Instagram
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>
