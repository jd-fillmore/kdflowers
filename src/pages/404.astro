---
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout title="404: Not found" path="/404/" noindex>
  <section class="pg-basic">
    <div class="container">
      <div class="pg-basic__inner">
        <p class="eyebrow">404</p>
        <h1>NOT FOUND</h1>
        <p class="pg-basic__text">
          You just hit a route that doesn&#39;t exist... the sadness.
        </p>
        <p class="pg-basic__actions">
          <a class="button" href="/">Go back to the homepage</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
